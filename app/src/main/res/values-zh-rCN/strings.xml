    <string name="app_name">填码</string>

    <string name="accessibility_label">填码</string>
    <string name="accessibility_description">在验证码栏位被选中时，暂时监看通知中的验证码，并在你确认后把验证码填入该栏位。不会读取短信收件箱，不会写入剪贴板，也不会在未确认时自动填入。</string>

    <string name="status_card_title">状态</string>
    <string name="status_listener_on">通知访问：已开启</string>
    <string name="status_listener_off">通知访问：未开启</string>
    <string name="status_accessibility_on">无障碍：已开启</string>
    <string name="status_accessibility_off">无障碍：未开启</string>
    <string name="status_armed">监看：进行中（等待验证码通知）</string>
    <string name="status_standby">监看：待机（尚未检测到验证码栏位）</string>
    <string name="status_disabled">监看：已关闭</string>
    <string name="status_need_permissions">监看：尚未就绪（需要权限）</string>

